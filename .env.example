# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Frontend (safe to share)
#
# Anything prefixed VITE_ is compiled into the browser bundle, so treat it as
# public. That's fine for these: the Supabase anon key is public by design and
# Row Level Security is what actually protects the data.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

VITE_SITE_NAME=Handmade by Nanny Rae Rae's
VITE_SITE_URL=http://localhost:8080

# Optional — only needed if you re-enable Google Places address autocomplete at
# checkout. See docs/ARCHITECTURE.md. Must use this exact VITE_ name.
# VITE_GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Server-side only — NEVER prefix these with VITE_
#
# In production these are Supabase Edge Function secrets, set with:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# They are listed here for reference only. You do not need them to run the
# site locally — the frontend never touches them.
# ---------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

BREVO_API_KEY=xkeysib-...
BREVO_FROM_EMAIL=orders@nannyraerae.com.au
BREVO_FROM_NAME=Nanny Rae Rae
BREVO_CONFIRMATION_TEMPLATE_ID=1
BREVO_SHIPPING_TEMPLATE_ID=2

# Where new-order notifications go
ADMIN_EMAIL=hello@bynannyraerae.com.au
